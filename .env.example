# Chantakorn Property — Firebase web app configuration
# Copy this file to .env.local and replace the placeholders.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Optional legacy Supabase fallback. It is ignored whenever Firebase is configured.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Application settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false
NEXT_PUBLIC_ENABLE_DEMO_DATA=false
NEXT_PUBLIC_AGENCY_NAME="CHANTAKORN PROPERTY"
NEXT_PUBLIC_AGENCY_PHONE="081-234-5678"
NEXT_PUBLIC_AGENCY_LINE="LINE Official Account"
NEXT_PUBLIC_AGENCY_LINE_URL=https://lin.ee/NMSe28T3
NEXT_PUBLIC_AGENCY_EMAIL="contact@chantakornproperty.com"
NEXT_PUBLIC_AGENCY_LOCATION="Hat Yai, Songkhla, Thailand"
